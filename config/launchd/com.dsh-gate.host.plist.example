<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dsh-gate.host</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/dsh-gate/scripts/dsh-gate.mjs</string>
    <string>host</string>
    <string>run</string>
    <string>--host</string>
    <string>http://127.0.0.1:8080</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/dsh-gate</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/dsh-gate/.dsh-state/logs/launchd-host.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/dsh-gate/.dsh-state/logs/launchd-host.log</string>
</dict>
</plist>
