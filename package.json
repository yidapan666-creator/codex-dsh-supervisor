{
  "name": "dsh-gate-workspace",
  "private": true,
  "description": "A thin, durable Codex supervisor bridge for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidapan666-creator/dsh-gate.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "vitest run",
    "build-id:update": "node scripts/update-build-identity.mjs --write",
    "build-id:check": "node scripts/update-build-identity.mjs --check",
    "link:dsh": "node scripts/link-local-dsh.mjs",
    "bootstrap": "node scripts/dsh-gate.mjs bootstrap",
    "doctor": "node scripts/dsh-gate.mjs doctor",
    "policy:explain": "node packages/decision-policy/dist/cli.js explain",
    "skill:install": "node scripts/install-codex-skill.mjs",
    "host:start": "node scripts/dsh-gate.mjs host start",
    "host:status": "node scripts/dsh-gate.mjs host status",
    "host:stop": "node scripts/dsh-gate.mjs host stop",
    "dist:bundle:online": "node scripts/build-release-bundle.mjs --kind online",
    "dist:bundle:offline": "node scripts/build-release-bundle.mjs --kind offline",
    "dist:pack:npm": "pnpm --filter @yidapan666-creator/dsh-gate pack --pack-destination dist/npm",
    "verify": "pnpm build && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
