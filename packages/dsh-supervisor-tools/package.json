{
  "name": "@dsh-gate/supervisor-tools",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-side handoff, artifact, and bounded recovery tools for Codex DSH Supervisor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidapan666-creator/codex-dsh-supervisor.git",
    "directory": "packages/dsh-supervisor-tools"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build-identity": {
      "types": "./build-identity.d.mts",
      "default": "./build-identity.mjs"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "build-identity.mjs",
    "build-identity.d.mts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/update-build-identity.mjs --check && tsc -p tsconfig.json",
    "check": "node ../../scripts/update-build-identity.mjs --check && tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8 <1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-host-apiproxy": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true }
  }
}
